            <uri>model://mechelangelo_final/meshes/Arms/ID1 DAE/ID1.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

    </link>

    <joint name="left_joint3" type="fixed">
      <parent>left_id2_link</parent>
      <child>left_id1_link</child>
      <pose relative_to="left_id2_link">0 0.40287 0 0 0 0</pose>
    </joint>


    <!-- LEFT HAND PART: visual-only placement test, fixed to ID1 -->
    <link name="left_hand_link">
      <pose>0 0.82741 1.9375 0 0 0</pose>
      <gravity>false</gravity>
