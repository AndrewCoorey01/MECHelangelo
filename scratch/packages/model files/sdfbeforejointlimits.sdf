            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="left_joint2" type="revolute">
      <parent>left_id3_link</parent>
      <child>left_id2_link</child>
      <pose relative_to="left_id3_link">0 0.09337 0 0 0 0</pose>
      <axis>
