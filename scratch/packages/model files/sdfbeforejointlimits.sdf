FINAL SDF BEFORE ADDING IN ARM JOINT LIMITS

<?xml version="1.0"?>
<sdf version="1.7">
  <model name="mechelangelo_final">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- =========================
         BASE
         New full base DAE replaces meshes/base/base.dae.
         ========================= -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0.10 0 0 0</pose>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.30</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.40</iyy><iyz>0.0</iyz>
          <izz>0.50</izz>
        </inertia>
      </inertial>

      <collision name="base_collision"> 
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <mesh><uri>model://mechelangelo_final/meshes/base_final/final_design_body.dae</uri><scale>1 1 1</scale></mesh>
        </geometry>
      </collision>

      <visual name="base_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/base_final/final_design_body.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>

        <!-- TEST MATERIAL OVERRIDE: fake gunmetal -->
        <material>
            <ambient>0.15 0.15 0.15 1.0</ambient>
            <diffuse>0.07 0.07 0.07 1.0</diffuse>
            <specular>1.00 1.00 1.00 1.0</specular>
            <emissive>0.00 0.00 0.00 1.0</emissive>
        </material>
      </visual>
    </link>

    <!-- =========================
         DRIVEN WHEELS
         Requested centre offsets: x = 113 mm, y = +/-203 mm.
         z and rotations kept from original SDF.
         ========================= -->
    <link name="wheel_left_link">
      <inertial>
        <pose>0.113 0.203 0.075 0 0 0</pose>
        <mass>1.0</mass>
        <inertia><ixx>0.002</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>0.001</iyy><iyz>0.0</iyz><izz>0.002</izz></inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <pose>0.113 0.203 0.075 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.075</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="wheel_left_visual">
        <pose>0.113 0.203 0.075 0 0 0</pose>
        <geometry><mesh><uri>model://mechelangelo_final/meshes/wheels/wheel.dae</uri><scale>1 1 1</scale></mesh></geometry>
      </visual>
    </link>

    <link name="wheel_right_link">
      <inertial>
        <pose>0.113 -0.203 0.075 0 0 0</pose>
        <mass>1.0</mass>
        <inertia><ixx>0.002</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>0.001</iyy><iyz>0.0</iyz><izz>0.002</izz></inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <pose>0.113 -0.203 0.075 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.075</radius><length>0.03</length></cylinder></geometry>
      </collision>
      <visual name="wheel_right_visual">
        <pose>0.113 -0.203 0.075 0 0 0</pose>
        <geometry><mesh><uri>model://mechelangelo_final/meshes/wheels/wheel.dae</uri><scale>1 1 1</scale></mesh></geometry>
      </visual>
    </link>

    <!-- =========================
         CASTER WHEELS
         Two rear caster support spheres at x = -135 mm, y = +/-160 mm.
         They are fixed to the base, self-collision is disabled at model level,
         and low friction helps them behave like free casters.
         ========================= -->
    <link name="caster_left_link">
      <inertial>
        <pose>-0.135 0.160 0.030 0 0 0</pose>
        <mass>0.2</mass>
        <inertia><ixx>0.0001</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>0.0001</iyy><iyz>0.0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="caster_left_collision">
        <pose>-0.135 0.160 0.030 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface><friction><ode><mu>0.10</mu><mu2>0.10</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_left_visual">
        <pose>-0.135 0.160 0.030 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
      </visual>
    </link>

    <link name="caster_right_link">
      <inertial>
        <pose>-0.135 -0.160 0.030 0 0 0</pose>
        <mass>0.2</mass>
        <inertia><ixx>0.0001</ixx><ixy>0.0</ixy><ixz>0.0</ixz><iyy>0.0001</iyy><iyz>0.0</iyz><izz>0.0001</izz></inertia>
      </inertial>
      <collision name="caster_right_collision">
        <pose>-0.135 -0.160 0.030 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface><friction><ode><mu>0.10</mu><mu2>0.10</mu2></ode></friction></surface>
      </collision>
      <visual name="caster_right_visual">
        <pose>-0.135 -0.160 0.030 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
      </visual>
    </link>

    <!-- =========================
         IMU
         ========================= -->
    <link name="imu_link">
      <sensor name="mechelangelo_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <plugin name="mechelangelo_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=/imu</remapping></ros>
        </plugin>
      </sensor>
    </link>

    <!-- =========================
         LIDAR
         The original SDF referenced lds.dae. Your sensors folder lists lds.stl,
         so the visual was corrected to lds.stl while the /scan plugin is unchanged.
         ========================= -->
    <link name="base_scan">
      <visual name="lidar_visual">
        <pose>0 0 0.280 0 0 0</pose>
        <geometry><mesh><uri>model://mechelangelo_final/meshes/sensors/lds.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </visual>

      <sensor name="mechelangelo_lidar" type="ray">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <pose>0 0 0.280 0 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="mechelangelo_laserscan_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=/scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_scan</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- =========================
         CAMERA
         Kept as simple simulation camera box because the new sensor DAE files
         were not part of the requested active robot geometry update.
         ========================= -->
    <link name="camera_link">
      <pose>0.12 0 1.48 0 0 0</pose>
      <gravity>false</gravity>

      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.000001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000001</iyy><iyz>0</iyz><izz>0.000001</izz>
        </inertia>
      </inertial>

      <visual name="camera_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.08 0.05 0.04</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>

      <sensor name="camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>

        <camera name="picam">
          <horizontal_fov>1.085595</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>100</far></clip>
        </camera>

        <plugin name="camera_driver" filename="/opt/ros/humble/lib/libgazebo_ros_camera.so">
          <ros>
            <namespace>/mechelangelo</namespace>
            <remapping>image_raw:=camera/image_raw</remapping>
            <remapping>camera_info:=camera/camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>camera_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- =========================
         BASE JOINTS
         ========================= -->
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>wheel_left_link</child>
      <pose>0.113 0.203 0.075 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>wheel_right_link</child>
      <pose>0.113 -0.203 0.075 0 0 0</pose>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>

    <joint name="caster_left_joint" type="fixed">
      <parent>base_link</parent><child>caster_left_link</child>
      <pose>-0.135 0.160 0.030 0 0 0</pose>
    </joint>

    <joint name="caster_right_joint" type="fixed">
      <parent>base_link</parent><child>caster_right_link</child>
      <pose>-0.135 -0.160 0.030 0 0 0</pose>
    </joint>

    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent><child>imu_link</child>
      <pose>0.0 0 0.068 0 0 0</pose>
    </joint>

    <joint name="scan_joint" type="fixed">
      <parent>base_link</parent><child>base_scan</child>
      <pose>0 0 0.280 0 0 0</pose>
    </joint>


    



    <!-- =========================
         ARM CAD LINKS: ID4 + ID3 + ID2 + ID1 + HAND
         This restores ID3 between ID4 and ID2.
         ID4 and ID3 keep the confirmed orientation/height.
         ID2 is placed 93.37 mm from the ID3/ID4 joint centre.
         Arm visual and collision geometry use the DAE meshes as requested.
         ========================= -->

    <!-- LEFT ID4: fixed shoulder / first CAD arm part -->
    <link name="left_id4_link">
      <pose>0 0.2378 1.9375 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>

      <inertial>
        <pose>0 0 0 1.5708 0 0</pose>
        <mass>0.60</mass>
        <inertia>
          <ixx>0.004</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.004</iyy><iyz>0</iyz>
          <izz>0.004</izz>
        </inertia>
      </inertial>

      <visual name="left_id4_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID4 Dae/ID4.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.00 0.00 1.0</ambient>
          <diffuse>0.35 0.01 0.01 1.0</diffuse>
          <specular>1.00 0.60 0.60 1.0</specular>
          <emissive>0.00 0.00 0.00 1.0</emissive>
        </material>
      </visual>

      <collision name="left_id4_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID4 Dae/ID4.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="left_id4_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_id4_link</child>
    </joint>

    <!-- LEFT ID3: child of ID4, origin at ID4 connection joint -->
    <link name="left_id3_link">
      <pose>0 0.2378 1.9375 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>

      <inertial>
        <pose>0 0 0 -1.5708 0 0</pose>
        <mass>0.45</mass>
        <inertia>
          <ixx>0.003</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.003</iyy><iyz>0</iyz>
          <izz>0.003</izz>
        </inertia>
      </inertial>

      <visual name="left_id3_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID3 Dae/ID3.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.00 0.00 1.0</ambient>
          <diffuse>0.35 0.01 0.01 1.0</diffuse>
          <specular>1.00 0.60 0.60 1.0</specular>
          <emissive>0.00 0.00 0.00 1.0</emissive>
        </material>
      </visual>

      <collision name="left_id3_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID3 Dae/ID3.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="left_joint1" type="revolute">
      <parent>left_id4_link</parent>
      <child>left_id3_link</child>
      <pose relative_to="left_id4_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.1416</lower>
          <upper>3.1416</upper>
          <effort>25</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- LEFT ID2: child of ID3, offset 93.37 mm from ID3/ID4 joint -->
    <link name="left_id2_link">
      <pose>0 0.33117 1.9375 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>

      <inertial>
        <pose>0 0 0 1.5708 0 0</pose>
