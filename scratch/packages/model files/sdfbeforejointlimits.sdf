    <!-- LEFT ID1: visual-only placement test, fixed to ID2 to prevent physics instability -->
    <link name="left_id1_link">
      <pose>0 0.73404 1.9375 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>

      <inertial>
