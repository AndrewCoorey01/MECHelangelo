      </visual>

      <collision name="right_id3_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID3 Dae/ID3.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="right_joint1" type="revolute">
      <parent>right_id4_link</parent>
      <child>right_id3_link</child>
      <pose relative_to="right_id4_link">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.1416</lower>
          <upper>3.1416</upper>
          <effort>25</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- RIGHT ID2: child of ID3, offset 93.37 mm from ID3/ID4 joint -->
    <link name="right_id2_link">
      <pose>0 -0.33117 1.9375 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>

      <inertial>
        <pose>0 0 0 -1.5708 0 0</pose>
        <mass>0.80</mass>
        <inertia>
          <ixx>0.020</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.020</iyy><iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>

      <visual name="right_id2_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID2 DAE/id2.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.00 0.02 0.10 1.0</ambient>
          <diffuse>0.00 0.08 0.38 1.0</diffuse>
          <specular>0.45 0.75 1.00 1.0</specular>
          <emissive>0.00 0.00 0.00 1.0</emissive>
        </material>
      </visual>

      <collision name="right_id2_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID2 DAE/id2.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="right_joint2" type="revolute">
      <parent>right_id3_link</parent>
      <child>right_id2_link</child>
      <pose relative_to="right_id3_link">0 -0.09337 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.1416</lower>
          <upper>3.1416</upper>
          <effort>20</effort>
          <velocity>1.5</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>


    <!-- RIGHT ID1: visual-only placement test, fixed to ID2 to prevent physics instability -->
    <link name="right_id1_link">
      <pose>0 -0.73404 1.9375 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>

      <inertial>
        <pose>0 0 0 -1.5708 0 0</pose>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>

      <visual name="right_id1_visual">
        <pose>0 0 0 -1.5708 0 -3.1416</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID1 DAE/ID1.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.00 0.00 1.0</ambient>
          <diffuse>0.35 0.01 0.01 1.0</diffuse>
          <specular>1.00 0.60 0.60 1.0</specular>
          <emissive>0.00 0.00 0.00 1.0</emissive>
        </material>
      </visual>


      <collision name="right_id1_collision">
        <pose>0 0 0 -1.5708 0 -3.1416</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/ID1 DAE/ID1.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

    </link>

    <joint name="right_joint3" type="fixed">
      <parent>right_id2_link</parent>
      <child>right_id1_link</child>
      <pose relative_to="right_id2_link">0 -0.40287 0 0 0 0</pose>
    </joint>


    <!-- RIGHT HAND PART: visual-only placement test, fixed to ID1 -->
    <link name="right_hand_link">
      <pose>0 -0.82741 1.9375 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>

      <inertial>
        <pose>0 0 0 -1.5708 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0005</iyy><iyz>0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>

      <visual name="right_hand_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/hand part DAE/hand_part.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.00 0.02 0.10 1.0</ambient>
          <diffuse>0.00 0.08 0.38 1.0</diffuse>
          <specular>0.45 0.75 1.00 1.0</specular>
          <emissive>0.00 0.00 0.00 1.0</emissive>
        </material>
      </visual>


      <collision name="right_hand_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://mechelangelo_final/meshes/Arms/hand part DAE/hand_part.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>

    </link>

    <joint name="right_hand_joint" type="revolute">
      <parent>right_id1_link</parent>
      <child>right_hand_link</child>
      <pose relative_to="right_id1_link">0 -0.09337 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.5708</lower>
          <upper>1.5708</upper>
          <effort>10</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- =========================
         PLUGINS
         ========================= -->
    <plugin name="mechelangelo_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.406</wheel_separation>
      <wheel_diameter>0.15</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>

    <plugin name="mechelangelo_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=/joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>left_joint1</joint_name>
      <joint_name>right_joint1</joint_name>
      <joint_name>left_joint2</joint_name>
      <joint_name>right_joint2</joint_name>
      <joint_name>left_hand_joint</joint_name>
      <joint_name>right_hand_joint</joint_name>
    </plugin>

    <!--
      IMPORTANT FOR COMMANDING THE ARMS:
      This SDF defines stable revolute joints with damping/friction and keeps
      the old joint names for code compatibility, but exact position-hold and
      command-to-angle behaviour normally requires a ROS 2 controller, for example
      gazebo_ros2_control + joint_trajectory_controller, or a custom Gazebo plugin.
    -->

  </model>
</sdf>