<?xml version="1.0"?>
<robot name="mechelangelo_final">

  <!-- Materials for RViz. DAE embedded materials may still display depending on RViz settings. -->
  <material name="gunmetal">
    <color rgba="0.07 0.07 0.07 1.0"/>
  </material>
  <material name="hot_red">
    <color rgba="0.35 0.01 0.01 1.0"/>
  </material>
  <material name="hot_blue">
    <color rgba="0.00 0.08 0.38 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <!-- =========================
       BASE
       ========================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="12.0"/>
      <inertia ixx="0.30" ixy="0" ixz="0" iyy="0.40" iyz="0" izz="0.50"/>
    </inertial>
    <visual name="base_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/base_final/final_design_body.dae" scale="1 1 1"/>
      </geometry>
      <material name="gunmetal"/>
    </visual>
    <collision name="base_collision">
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/base_final/final_design_body.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <!-- =========================
       DRIVEN WHEELS
       ========================= -->
  <link name="wheel_left_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/>
    </inertial>
    <visual name="wheel_left_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/wheels/wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="wheel_left_collision">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.03"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.002"/>
    </inertial>
    <visual name="wheel_right_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/wheels/wheel.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision name="wheel_right_collision">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.113 0.203 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.113 -0.203 0.075" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- =========================
       CASTER WHEELS
       ========================= -->
  <link name="caster_left_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual name="caster_left_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision name="caster_left_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <link name="caster_right_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual name="caster_right_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision name="caster_right_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="caster_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_left_link"/>
    <origin xyz="-0.135 0.160 0.030" rpy="0 0 0"/>
  </joint>
  <joint name="caster_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_right_link"/>
    <origin xyz="-0.135 -0.160 0.030" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       SENSORS
       ========================= -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual name="lidar_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.280" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual name="camera_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.05 0.04"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.12 0 1.48" rpy="0 0 0"/>
  </joint>

  <!-- =========================
       LEFT ARM: ID4 + ID3 + ID2 + ID1 + HAND
       ========================= -->
  <link name="left_id4_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.60"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual name="left_id4_visual">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID4 Dae/ID4.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_red"/>
    </visual>
    <collision name="left_id4_collision">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID4 Dae/ID4.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_id4_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_id4_link"/>
    <origin xyz="0 0.2378 1.9375" rpy="0 0 0"/>
  </joint>

  <link name="left_id3_link">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual name="left_id3_visual">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID3 Dae/ID3.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_red"/>
    </visual>
    <collision name="left_id3_collision">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID3 Dae/ID3.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_joint1" type="revolute">
    <parent link="left_id4_link"/>
    <child link="left_id3_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="25" velocity="1.5"/>
  </joint>

  <link name="left_id2_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.80"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.005"/>
    </inertial>
    <visual name="left_id2_visual">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID2 DAE/id2.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_blue"/>
    </visual>
    <collision name="left_id2_collision">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID2 DAE/id2.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_joint2" type="revolute">
    <parent link="left_id3_link"/>
    <child link="left_id2_link"/>
    <origin xyz="0 0.09337 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="1.5"/>
  </joint>

  <link name="left_id1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual name="left_id1_visual">
      <origin xyz="0 0 0" rpy="1.5708 0 3.1416"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID1 DAE/ID1.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_red"/>
    </visual>
    <collision name="left_id1_collision">
      <origin xyz="0 0 0" rpy="1.5708 0 3.1416"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID1 DAE/ID1.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_joint3" type="fixed">
    <parent link="left_id2_link"/>
    <child link="left_id1_link"/>
    <origin xyz="0 0.40287 0" rpy="0 0 0"/>
  </joint>

  <link name="left_hand_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual name="left_hand_visual">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/hand part DAE/hand_part.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_blue"/>
    </visual>
    <collision name="left_hand_collision">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/hand part DAE/hand_part.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_hand_joint" type="revolute">
    <parent link="left_id1_link"/>
    <child link="left_hand_link"/>
    <origin xyz="0 0.09337 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.0"/>
  </joint>

  <!-- =========================
       RIGHT ARM: ID4 + ID3 + ID2 + ID1 + HAND
       ========================= -->
  <link name="right_id4_link">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <mass value="0.60"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual name="right_id4_visual">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID4 Dae/ID4.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_red"/>
    </visual>
    <collision name="right_id4_collision">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID4 Dae/ID4.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_id4_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_id4_link"/>
    <origin xyz="0 -0.2378 1.9375" rpy="0 0 0"/>
  </joint>

  <link name="right_id3_link">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
    <visual name="right_id3_visual">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID3 Dae/ID3.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_red"/>
    </visual>
    <collision name="right_id3_collision">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID3 Dae/ID3.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_joint1" type="revolute">
    <parent link="right_id4_link"/>
    <child link="right_id3_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="25" velocity="1.5"/>
  </joint>

  <link name="right_id2_link">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <mass value="0.80"/>
      <inertia ixx="0.020" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.005"/>
    </inertial>
    <visual name="right_id2_visual">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID2 DAE/id2.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_blue"/>
    </visual>
    <collision name="right_id2_collision">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID2 DAE/id2.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_joint2" type="revolute">
    <parent link="right_id3_link"/>
    <child link="right_id2_link"/>
    <origin xyz="0 -0.09337 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="1.5"/>
  </joint>

  <link name="right_id1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual name="right_id1_visual">
      <origin xyz="0 0 0" rpy="-1.5708 0 -3.1416"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID1 DAE/ID1.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_red"/>
    </visual>
    <collision name="right_id1_collision">
      <origin xyz="0 0 0" rpy="-1.5708 0 -3.1416"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/ID1 DAE/ID1.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_joint3" type="fixed">
    <parent link="right_id2_link"/>
    <child link="right_id1_link"/>
    <origin xyz="0 -0.40287 0" rpy="0 0 0"/>
  </joint>

  <link name="right_hand_link">
    <inertial>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual name="right_hand_visual">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/hand part DAE/hand_part.dae" scale="1 1 1"/>
      </geometry>
      <material name="hot_blue"/>
    </visual>
    <collision name="right_hand_collision">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://mechelangelo_description/meshes/Arms/hand part DAE/hand_part.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_hand_joint" type="revolute">
    <parent link="right_id1_link"/>
    <child link="right_hand_link"/>
    <origin xyz="0 -0.09337 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10" velocity="1.0"/>
  </joint>

</robot>