# Doxyfile for MECHelangelo
# Run: doxygen docs/Doxyfile   (from the repository root)
# Output: docs/doxygen/html/index.html

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "MECHelangelo"
PROJECT_BRIEF          = "Autonomous gallery robot - ROS 2 Humble, Raspberry Pi 5"
PROJECT_NUMBER         = "Autumn 2026"
OUTPUT_DIRECTORY       = docs/doxygen

#---------------------------------------------------------------------------
# Input  (all paths are relative to the repository root where doxygen is run)
#---------------------------------------------------------------------------
INPUT                  = src docs README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.hpp *.h *.py *.dox *.md
EXTENSION_MAPPING      = py=Python
EXCLUDE                = src/mechelangelo_imu_driver/sense_hat \
                         src/mechelangelo_perception/test \
                         src/**/__pycache__
EXCLUDE_PATTERNS       = */__pycache__/* *.pyc

#---------------------------------------------------------------------------
# Main page  (mainpage.dox defines @mainpage so it must be in INPUT above)
#---------------------------------------------------------------------------
USE_MDFILE_AS_MAINPAGE =

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

#---------------------------------------------------------------------------
# Build
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

#---------------------------------------------------------------------------
# Diagrams (requires Graphviz / dot)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 4

#---------------------------------------------------------------------------
# Source browser
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

#---------------------------------------------------------------------------
# Aliases
#---------------------------------------------------------------------------
# None required — standard Doxygen tags are used throughout.
